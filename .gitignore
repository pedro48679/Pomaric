!README.md
!db_schema.md
!requirements.txt
!CNN2.py
!CNN5.py
!pipeline_apple_bom.ipynb
!gradcam_galeria_interativa.py
!RGBA_format.py
!split_multi_apple_crops.py
!scrape_apple_diseases.py
!supabase_data.py
!inference_server.py
