# ==============================================================================
# Gitignore - Projeto Pomaric (Classificação de Maçãs, Edge AI & Dashboard)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ambientes Virtuais e Cache Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/
ENV/
*.egg-info/
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 2. Caches e Artefactos de Build do Flutter / Dart (Dashboard)
# ------------------------------------------------------------------------------
dashboard/build/
dashboard/.dart_tool/
dashboard/local_db/
dashboard/.pub/
dashboard/.pub-cache/
dashboard/.flutter-plugins-dependencies
dashboard/ios/Flutter/.last_build_id
dashboard/*.iml
dashboard/android/app/debug/
dashboard/android/app/profile/
dashboard/android/app/release/

# Ficheiros/logs temporários de desenvolvimento dentro do dashboard
dashboard/fix.py
dashboard/fix_imports.py
dashboard/fix_text.py
dashboard/refactor_batch.py
dashboard/scratch_*.txt
dashboard/analyze_full.txt
dashboard/*.log

# ------------------------------------------------------------------------------
# 3. Modelos Pesados de IA e Datasets Temporários
# ------------------------------------------------------------------------------
# Ignorar modelos .pth gigantes intermédios (exceto modelos chave se necessário)
melhor_weight_multiclass_RESnet50_*.pth
!melhor_weight_multiclass_RESnet50_BEST.pth

# Pastas de dados temporários e caches locais
apples_2026/
pipeline_ALL_night_done/
scrappa/
TempRaspberry/
_rejeitadas/

# ------------------------------------------------------------------------------
# 4. Ficheiros Auxiliares LaTeX e Rascunhos de Documentação
# ------------------------------------------------------------------------------
*.aux
*.toc
*.out
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.log

# Rascunhos markdown de progresso / ideias
casos_uso_bruto_plantuml.md
diagramas_seq.md
diagramas_atividade.md
comparacao_modelos.md
revisao_conclusao.md
REDESIGN_PLAN.md
SPC_CHARTS_BACKUP.md
batch_upgrade.md
AUTENTICACAO_RESUMO.md

# ------------------------------------------------------------------------------
# 5. Ficheiros de Chaves / Segredos / Credenciais
# ------------------------------------------------------------------------------
.env
secrets.local.ps1
dashboard/android/app/google-services.json
dashboard/ios/Runner/GoogleService-Info.plist
dashboard/firebase.json

# Ficheiros com URL do projeto Supabase hardcoded
supabase_data.py
ONXX/raspberry_camera_format.py

# Ficheiros .service com referências ao projeto Supabase
ONXX/pomaric-camera.service
ONXX/pomaric-camera_new.service

# ------------------------------------------------------------------------------
# 6. IDEs, Editores e Sistema Operativo
# ------------------------------------------------------------------------------
.vscode/
.idea/
.claude/
.cursor/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
