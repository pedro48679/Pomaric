# Ignore everything by default
*

# Allow directory traversal for allowed folders
!dashboard/
!suporte_camera/
!ONXX/
!print/

# Allow everything inside the permitted folders
!dashboard/**
!suporte_camera/**

# RE-IGNORE SECRETS DENTRO DO DASHBOARD
dashboard/android/app/google-services.json
dashboard/ios/Runner/GoogleService-Info.plist
dashboard/firebase.json
.env

!print/**

# ...except one-off dev/scratch files inside dashboard/ that add no value
# to the public repo (encoding-fix scripts, throwaway notes/backups).
dashboard/fix.py
dashboard/fix_imports.py
dashboard/fix_text.py
dashboard/refactor_batch.py
dashboard/scratch_layout.txt
dashboard/scratch_scatter.txt
dashboard/batch_upgrade.md
dashboard/REDESIGN_PLAN.md
dashboard/SPC_CHARTS_BACKUP.md

