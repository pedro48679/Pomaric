  Widget _overconfidenceCorrectionsChart(Batch batch, List<CorrectionHistory> corrections) {
    // This reuses the SupabaseService.getManualReviews logic already in place.
    const labels = ['<60%', '60-70%', '70-80%', '80-90%', '90%+'];

    return FutureBuilder<List<Map<String, dynamic>>> (
      future: SupabaseService.getManualReviews(batchId: batch.id),
      builder: (context, snapshot) {
        if (snapshot.connectionState != ConnectionState.done) return GlassCard(padding: const EdgeInsets.all(20), height: 320, child: const Center(child: CircularProgressIndicator()));
        final rows = snapshot.data ?? [];
        final totalByBucket = List<int>.filled(labels.length, 0);
        final confidentIncorrect = List<int>.filled(labels.length, 0);

        for (final r in rows) {
          final conf = ((r['original_confidence'] ?? 0) as num).toDouble();
          final idx = conf < 60 ? 0 : conf < 70 ? 1 : conf < 80 ? 2 : conf < 90 ? 3 : 4;
          totalByBucket[idx]++;
          final orig = r['original_class']?.toString();
          final corr = r['corrected_class']?.toString();
          if (corr != null && corr.isNotEmpty && orig != null && orig != corr) confidentIncorrect[idx]++;
        }

        final maxVal = (totalByBucket + confidentIncorrect).fold<int>(0, (p, e) => e > p ? e : p).toDouble();
        final dynamicMaxY = (maxVal > 5 ? maxVal + 2 : 6.0).toDouble();

        final barGroups = labels.asMap().entries.map((entry) {
          final idx = entry.key;
          return BarChartGroupData(
            x: idx,
            barsSpace: 6,
            barRods: [
              BarChartRodData(toY: totalByBucket[idx].toDouble(), width: 14, color: Colors.white24, borderRadius: BorderRadius.circular(4)),
              BarChartRodData(toY: confidentIncorrect[idx].toDouble(), width: 10, color: Colors.redAccent, borderRadius: BorderRadius.circular(4)),
            ],
          );
        }).toList();

        return GlassCard(
          padding: const EdgeInsets.all(20),
          height: 320,
          child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
              const Text('Correções Manuais - Excesso de Confiança', style: TextStyle(color: Colors.white, fontSize: 15, fontWeight: FontWeight.bold)),
              Tooltip(message: 'Barra clara = total correções; barra vermelha = correções onde a classe foi alterada (overconfident cases).', child: const Icon(Icons.info_outline, color: Colors.white54))
            ]),
            const SizedBox(height: 6),
            Expanded(child: BarChart(BarChartData(
              maxY: dynamicMaxY,
              gridData: FlGridData(show: true, drawVerticalLine: false, getDrawingHorizontalLine: (_) => FlLine(color: Colors.white10)),
              borderData: FlBorderData(show: false),
              titlesData: FlTitlesData(bottomTitles: AxisTitles(sideTitles: SideTitles(showTitles: true, reservedSize: 22, getTitlesWidget: (v,_) => Text(labels[v.toInt()], style: const TextStyle(color: Colors.white38, fontSize: 10)))), leftTitles: AxisTitles(sideTitles: SideTitles(showTitles: true, reservedSize: 28, getTitlesWidget: (v,_) => Text('${v.toInt()}', style: const TextStyle(color: Colors.white38, fontSize: 9))))),
              barGroups: barGroups,
            ))),
            const SizedBox(height: 8),
            Row(children: [Container(width: 10, height: 10, color: Colors.white24), const SizedBox(width: 6), const Text('Total Correções', style: TextStyle(color: Colors.white38, fontSize: 10)), const SizedBox(width: 12), Container(width: 10, height: 10, color: Colors.redAccent), const SizedBox(width: 6), const Text('Excesso de Confiança', style: TextStyle(color: Colors.white38, fontSize: 10))])
          ]),
        );
      }
    );
  }

